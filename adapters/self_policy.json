{
  "version": 1,
  "default_region": "external",
  "regions": [
    {
      "name": "core",
      "core": true,
      "patterns": [
        "Architecture",
        "architecture_core.*"
      ]
    },
    {
      "name": "stdlib",
      "core": true,
      "patterns": [
        "argparse",
        "ast",
        "bytes",
        "collections",
        "contextlib",
        "core",
        "csv",
        "dataclasses*",
        "datetime",
        "encoding/json",
        "enum",
        "flag",
        "fnmatch*",
        "fmt",
        "glob",
        "go/parser",
        "go/token",
        "hashlib",
        "io",
        "itertools",
        "json",
        "logging",
        "math",
        "node:child_process",
        "node:fs",
        "node:path",
        "os",
        "os/exec",
        "path/filepath",
        "pathlib",
        "posixpath",
        "random",
        "re",
        "shutil",
        "sort",
        "std",
        "strconv",
        "strings",
        "subprocess",
        "sys",
        "tempfile",
        "time",
        "tomllib",
        "traceback",
        "typing*"
      ]
    },
    {
      "name": "infrastructure",
      "core": false,
      "patterns": ["extract_common"]
    },
    {
      "name": "adapters",
      "core": false,
      "patterns": [
        "extract_*",
        "check_self",
        "check_architecture",
        "extract_typescript_native",
        "rust_extractor",
        "architecture-extractors/go-extractor"
      ]
    },
    {
      "name": "external",
      "core": false,
      "patterns": []
    }
  ],
  "allowed": {
    "core": ["core", "stdlib"],
    "stdlib": ["stdlib"],
    "adapters": ["core", "stdlib", "adapters", "infrastructure", "external"],
    "infrastructure": ["stdlib", "infrastructure"],
    "external": ["external"]
  },
  "forbidden": {
    "core": [
      "extract_*",
      "check_self",
      "check_architecture",
      "extract_typescript_native",
      "rust_extractor",
      "architecture-extractors/go-extractor",
      "extract_common"
    ]
  }
}
